{
  "name": "myvue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build:prod": "pnpm run sitemap && pnpm exec vite build --mode production",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --mode production",
    "build-only": "vite build",
    "start": "pnpm run dev",
    "sitemap": "node updateSitemap.js",
    "lint-staged": "lint-staged",
    "check:type": "vue-tsc --build --noEmit --force",
    "check:prettier": "prettier --check .",
    "check": "eslint .",
    "lint": "eslint . --fix",
    "lint:prettier": "prettier . --write",
    "lint:commitlint": "commitlint --edit $1",
    "lint:diff": "git add . && pnpm exec lint-staged",
    "commit": "pnpm run lint:diff && cz",
    "push": "git push Gitee && git push origin",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{cjs,mjs,js,jsx,tsx,ts,less,md,json}": [
      "pnpm exec eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@highlightjs/vue-plugin": "github:highlightjs/vue-plugin",
    "@tailwindcss/vite": "^4.1.13",
    "@vueuse/motion": "^3.0.3",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.12.2",
    "bignumber.js": "^9.3.1",
    "dayjs": "^1.11.18",
    "element-plus": "^2.11.3",
    "file-saver": "^2.0.5",
    "gridstack": "^12.3.3",
    "highlight.js": "^11.11.1",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1",
    "motion-v": "1.7.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "socket.io-client": "^4.8.1",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.1.13",
    "vue": "^3.5.21",
    "vue-intersect": "^3.0.0",
    "vue-router": "^4.5.1",
    "vue3-swatches": "^1.2.4",
    "wc-flow-layout": "^0.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.36.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.5.2",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/language-server": "^3.0.7",
    "@vue/tsconfig": "^0.8.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.93.0",
    "sass-loader": "^16.0.5",
    "sitemap": "^8.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-icons": "^22.3.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-html-minify": "^1.0.0",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-svg-icons-ng": "^1.4.1",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  }
}
